        loop
        playsinline
        preload="auto"
        class="h-full w-full object-cover opacity-40"
      ></video>
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950/60 via-slate-950/40 to-slate-950/80"></div>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h1
        class="text-[2.4rem] font-black uppercase leading-[0.9] tracking-[-0.06em] text-white sm:text-[4.1rem] lg:text-[5.5rem]"
        style="font-family:'Montserrat',sans-serif; text-shadow: 0 10px 28px rgba(15, 23, 42, 0.75);"
      >
        <span data-i18n="heroTitle">{t.heroTitle}</span>
      </h1>

      <p class="mt-3 text-lg font-semibold uppercase tracking-[0.18em] text-slate-200 sm:text-xl" style="font-family:'Montserrat',sans-serif; text-shadow: 0 6px 18px rgba(15, 23, 42, 0.5);">
        <span data-i18n="heroSub">{t.heroSub}</span>
      </p>

      <p class="mt-6 max-w-3xl text-base leading-relaxed text-slate-300 sm:text-lg">
        <span data-i18n="heroText">{t.heroText}</span>
      </p>

      <a
        href="https://wa.me/393793554548?text=Hi!%20I'm%20interested%20in%20booking%20a%20fishing%20trip%20with%20your%20charter.%20Could%20you%20please%20send%20me%20more%20info%20about%20your%20services%3F"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 mb-8 inline-flex items-center gap-2 rounded-lg bg-green-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-green-600/30 transition-all hover:bg-green-500"
      >
        <span data-i18n="bookNow">{t.bookNow}</span>
      </a>
    </div>
  </section>

  <section id="trips" class="bg-gradient-to-b from-white to-sky-50/60 py-16 sm:py-20">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-cyan-500 to-sky-600 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-white shadow-md shadow-cyan-500/30">
          <span data-i18n="tripsBadge">{t.tripsBadge}</span>
        </span>
        <h2 class="mt-4 text-3xl font-black text-slate-900 sm:text-4xl" style="font-family:'Montserrat',sans-serif">
          <span data-i18n="tripsTitleA">{t.tripsTitleA}</span> <span class="bg-gradient-to-r from-cyan-500 to-sky-600 bg-clip-text text-transparent" data-i18n="tripsTitleB">{t.tripsTitleB}</span>
        </h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tripsWithSchemes.map((trip) => (
          <article class="group overflow-hidden rounded-2xl border border-slate-200 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-cyan-200 hover:shadow-lg hover:shadow-cyan-100/60">
            <button
              type="button"
              class="trip-card-trigger block w-full cursor-pointer text-left"
              data-trip-id={trip.id}
              data-image={trip.image}
              aria-label={`${t.openDetails} ${trip.title}`}
            >
              <div class="aspect-[4/3] overflow-hidden bg-slate-100">
                <img src={trip.image} alt={trip.title} class="trip-card-image h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
              </div>

              <div class="h-2 w-full" style={trip.s.bar}></div>

              <div class="p-6">
                <h3 class="trip-card-title text-xl font-black" style={trip.s.titleGrad}>{trip.title}</h3>

                <div class="trip-card-pricing mt-2 flex flex-wrap gap-1">
                  {trip.pricing.split('|').map((p) => (
                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700 ring-1 ring-amber-200">
                      {p}
                    </span>
                  ))}
                </div>

                <p class="mt-3 text-sm text-slate-500">
                  <span class="trip-start-label">{t.start}</span>
                  <span class="trip-start-time">{trip.startTime}</span>
                </p>

                <ul class="mt-4 space-y-2">
                  {trip.features.map((feature) => (
                    <li class="flex items-center gap-2 text-sm text-slate-600">
                      <span class="trip-feature-text">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="vessel" class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl" data-i18n="vesselTitle">{t.vesselTitle}</h2>
    <div class="mt-6 space-y-4 text-base leading-relaxed text-slate-700">
      <p data-i18n="vessel1">{t.vessel1}</p>
      <p data-i18n="vessel2">{t.vessel2}</p>
      <p data-i18n="vessel3">{t.vessel3}</p>
    </div>
  </section>

  <div id="trip-modal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-slate-950/90 p-3 sm:p-4">
    <button
      type="button"
      id="trip-modal-close"
      class="absolute right-3 top-3 z-10 rounded-md border border-slate-300 bg-white/90 px-3 py-2 text-sm text-slate-700 transition hover:bg-slate-100 sm:right-4 sm:top-4"
      aria-label={t.closeAria}
    >
      {t.close}
    </button>

    <div class="flex max-h-[90dvh] w-full max-w-3xl flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
      <div class="min-h-0 flex-1 overflow-y-auto">
        <div class="space-y-3 p-4 sm:space-y-4 sm:p-6">
          <h3 id="trip-modal-title" class="text-xl font-semibold text-slate-900 sm:text-2xl"></h3>
          <p id="trip-modal-start" class="text-sm text-slate-500"></p>
          <div id="trip-modal-pricing" class="inline-flex items-center gap-2 rounded-xl bg-amber-50 px-4 py-2 text-sm font-bold text-amber-700 ring-1 ring-amber-200"></div>
          <div id="trip-modal-features" class="flex flex-wrap gap-2"></div>
          <p id="trip-modal-description" class="text-sm leading-relaxed text-slate-700"></p>
        </div>
      </div>
    </div>
  </div>

  <section id="brands" class="border-y border-slate-200 bg-white py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-slate-800 to-slate-600 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-white shadow-md shadow-slate-900/20">
          <span data-i18n="brandsBadge">{t.brandsBadge}</span>
        </span>
        <h2 class="mt-4 text-3xl font-black text-slate-900 sm:text-4xl" style="font-family:'Montserrat',sans-serif">
          <span data-i18n="brandsTitleA">{t.brandsTitleA}</span><span class="text-slate-700" data-i18n="brandsTitleB">{t.brandsTitleB}</span><span data-i18n="brandsTitleC">{t.brandsTitleC}</span>
        </h2>
      </div>

      {brandLogos.length > 0 ? (
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-6 shadow-sm sm:px-6">
          <div class="brand-marquee-track flex w-max min-w-full items-center gap-6 sm:gap-8">
            {[...brandLogos, ...brandLogos].map((brand, index) => (
              <div class="brand-item flex items-center justify-center rounded-xl border border-slate-200 bg-white p-3 shadow-sm" key={`${brand.name}-${index}`}>
                <img src={brand.src} alt={brand.alt} class="h-16 w-auto max-w-[160px] object-contain sm:h-20" loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      ) : (
        <p class="mt-6 text-center text-slate-500">
          <span data-i18n="brandsEmptyA">{t.brandsEmptyA}</span><span class="font-semibold">public/brands</span><span data-i18n="brandsEmptyB">{t.brandsEmptyB}</span>
        </p>
      )}
    </div>
  </section>

  <section id="gallery" class="bg-gradient-to-br from-sky-50 via-cyan-50 to-blue-50 py-16 sm:py-24">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-cyan-500 to-sky-600 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-white shadow-md shadow-cyan-500/30">
          <span data-i18n="galleryBadge">{t.galleryBadge}</span>
        </span>
        <h2 class="mt-4 text-3xl font-black text-slate-900 sm:text-4xl" style="font-family:'Montserrat',sans-serif; background:linear-gradient(135deg,#0891b2,#0369a1); -webkit-background-clip:text; -webkit-text-fill-color:transparent;" data-i18n="galleryTitle">
          {t.galleryTitle}
        </h2>
      </div>

      {galleryMedia.length > 0 ? (
        <div class="relative mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white/80 shadow-sm">
          <div
            id="gallery-carousel-track"
            class="flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-smooth pb-3 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
          >
            {galleryMedia.map((media, index) => (
              <button
                type="button"
                class="gallery-slide group relative shrink-0 snap-center overflow-hidden rounded-xl border border-slate-200 bg-slate-100 text-left shadow-sm transition hover:shadow-md"
                data-index={index}
                data-src={media.src}
                data-type={media.type}
                data-alt={media.alt}
                data-type-label={media.type}
                aria-label={`${media.type === 'video' ? t.openVideo : t.openImage}: ${media.alt}`}
                style="width: min(58vw, 300px);"
              >
                {media.type === 'video' ? (
                  <video
                    src={media.src}
                    class="aspect-[4/3] h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    muted
                    loop
                    playsinline
                    preload="metadata"
                  />
                ) : (
                  <img src={media.src} alt={media.alt} class="aspect-[4/3] h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                )}
                <p class="border-t border-slate-100 bg-white/90 px-3 py-2 text-xs font-medium text-slate-600 backdrop-blur-sm">{media.alt}</p>
              </button>
            ))}
          </div>
        </div>
      ) : (
        <p class="mt-6 text-center text-slate-500"><span data-i18n="galleryEmptyA">{t.galleryEmptyA}</span><span>public/gallery</span><span data-i18n="galleryEmptyB">{t.galleryEmptyB}</span></p>
      )}
    </div>
  </section>

  <section id="faq" class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-amber-400 to-orange-500 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-white shadow-md shadow-amber-500/30">
          FAQ
        </span>
        <h2 id="faq-title" class="mt-4 text-3xl font-black text-slate-900 sm:text-4xl" data-i18n="faqTitle">{t.faqTitle}</h2>
      </div>

      <div id="faq-list" class="space-y-4">
        {localizedFaq.map((entry) => entry[defaultLang]).map((item) => (
          <div class="faq-item rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="faq-question text-lg font-bold text-slate-900">{item.question}</h3>
            <p class="faq-answer mt-2 text-sm leading-relaxed text-slate-600">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    @keyframes brand-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    .brand-marquee-track {
      animation: brand-scroll 26s linear infinite;
      will-change: transform;
    }

    .brand-marquee-track:hover {
      animation-play-state: paused;
    }

    .brand-item {
      flex: 0 0 auto;
      width: clamp(140px, 18vw, 220px);
      min-height: 96px;
    }
  </style>

  <script type="application/json" id="i18n-data" set:html={JSON.stringify(i18nData)} />

  <script>
    const i18nData = JSON.parse(document.getElementById('i18n-data')?.textContent || '{}');
    const supportedLangs = ['en', 'it'];
    const defaultLang = 'en';
    const readStoredLang = () => {
      try {
        const stored = localStorage.getItem('lang');
        return stored && supportedLangs.includes(stored) ? stored : defaultLang;
      } catch (error) {
        return defaultLang;
      }
    };
    let currentLang = readStoredLang();
    let openTripId = null;

    const modal = document.getElementById('trip-modal');
    const modalTitle = document.getElementById('trip-modal-title');
    const modalStart = document.getElementById('trip-modal-start');
    const modalPricing = document.getElementById('trip-modal-pricing');
    const modalFeatures = document.getElementById('trip-modal-features');
    const modalDescription = document.getElementById('trip-modal-description');
    const closeButton = document.getElementById('trip-modal-close');

    const escapeHtml = (value) =>
      String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);

    const getTrip = (id) => (i18nData.trips || []).find((trip) => String(trip.id) === String(id));

    function renderModal() {
      if (!modalTitle || !modalStart || !modalPricing || !modalFeatures || !modalDescription) return;
      const trip = getTrip(openTripId);
      if (!trip) return;
      const text = trip[currentLang];
      const ui = i18nData.ui[currentLang];

      modalTitle.textContent = text.title;
      modalStart.textContent = `${ui.start}: ${text.startTime}`;
      modalPricing.textContent = text.pricing;
      modalDescription.textContent = text.description;
      modalFeatures.innerHTML = text.features
        .map((feature) => `<span class="rounded-full bg-sky-50 px-2 py-1 text-xs font-medium text-sky-700 ring-1 ring-sky-200">${escapeHtml(feature)}</span>`)
        .join('');
    }

    function closeModal() {
      if (!modal) return;
      openTripId = null;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    if (closeButton) {
      closeButton.addEventListener('click', closeModal);
    }

    document.querySelectorAll('.trip-card-trigger').forEach((button) => {
      button.addEventListener('click', () => {
        if (!modal) return;
        openTripId = button.dataset.tripId;
        renderModal();

        modal.classList.remove('hidden');
        modal.classList.add('flex');
      });
    });

    const setText = (selector, value) => {
      document.querySelectorAll(selector).forEach((el) => {
        el.textContent = value;
      });
    };

    function applyLanguage(lang) {
      if (!supportedLangs.includes(lang) || !i18nData.ui) return;
      currentLang = lang;
      const ui = i18nData.ui[lang];

      document.documentElement.lang = lang;
      document.title = ui.pageTitle;

      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const value = ui[el.dataset.i18n];
        if (value !== undefined) el.textContent = value;
      });

      i18nData.trips.forEach((trip) => {
        const text = trip[lang];
        const trigger = document.querySelector(`.trip-card-trigger[data-trip-id="${trip.id}"]`);
        if (!trigger) return;
        trigger.setAttribute('aria-label', `${ui.openDetails} ${text.title}`);
        const image = trigger.querySelector('.trip-card-image');
        if (image) image.setAttribute('alt', text.title);
        const title = trigger.querySelector('.trip-card-title');
        if (title) title.textContent = text.title;
        const pricing = trigger.querySelector('.trip-card-pricing');
        if (pricing) {
          pricing.querySelectorAll('span').forEach((el, i) => {
            el.textContent = text.pricing.split('|')[i] ?? '';
          });
        }
        const startLabel = trigger.querySelector('.trip-start-label');
        if (startLabel) startLabel.textContent = ui.start;
        const startTime = trigger.querySelector('.trip-start-time');
        if (startTime) startTime.textContent = text.startTime;
        trigger.querySelectorAll('.trip-feature-text').forEach((el, i) => {
          el.textContent = text.features[i] ?? '';
        });
      });

      document.querySelectorAll('.gallery-slide').forEach((slide) => {
        const label = slide.dataset.type === 'video' ? ui.openVideo : ui.openImage;
        slide.setAttribute('aria-label', `${label}: ${slide.dataset.alt || ''}`);
      });

      document.querySelectorAll('#faq-list .faq-item').forEach((item, i) => {
        const entry = i18nData.faq[i]?.[lang];
        if (!entry) return;
        const question = item.querySelector('.faq-question');
        const answer = item.querySelector('.faq-answer');
        if (question) question.textContent = entry.question;
        if (answer) answer.textContent = entry.answer;
      });

      if (closeButton) {
        closeButton.textContent = ui.close;
        closeButton.setAttribute('aria-label', ui.closeAria);
      }
      renderModal();

      const navLabels = { home: ui.navHome, trips: ui.navTrips, vessel: ui.navVessel, faq: ui.navFaq, gallery: ui.navGallery, contact: ui.navContact };
      Object.entries(navLabels).forEach(([key, label]) => {
        setText(`[data-nav-key="${key}"]`, label);
        setText(`[data-footer-link-key="${key}"]`, label);
      });

      setText('#footer-links-title', ui.footerLinks);
      setText('#footer-contact-title', ui.footerContact);
      setText('#footer-email-label', ui.footerEmail);
      setText('#footer-phone-label', ui.footerPhone);
      setText('#footer-address-label', ui.footerAddress);
      setText('#footer-copyright', `© ${new Date().getFullYear()} Big Catch Fishing Charters. ${ui.footerRights}`);
      setText('#cookie-text', ui.cookieText);
      setText('#cookie-more', ui.cookieMore);
      setText('#cookie-accept', ui.cookieAccept);
      setText('#cookie-reject', ui.cookieReject);
    }

    document.addEventListener('lang-change', (event) => {
      const nextLang = event instanceof CustomEvent ? event.detail : null;
      applyLanguage(nextLang);
    });

    applyLanguage(currentLang);

    const heroVideo = document.getElementById('hero-video');
    const tryPlayHeroVideo = () => {
      if (!heroVideo) return;
      heroVideo.muted = true;
      heroVideo.playsInline = true;
      heroVideo.play().catch(() => {
        window.setTimeout(() => heroVideo.play().catch(() => {}), 250);
      });
    };

    if (heroVideo) {
      heroVideo.load();
      heroVideo.addEventListener('canplay', tryPlayHeroVideo, { once: true });
      heroVideo.addEventListener('loadeddata', tryPlayHeroVideo, { once: true });
      window.addEventListener('load', tryPlayHeroVideo, { once: true });
      setTimeout(tryPlayHeroVideo, 150);
    }

    modal?.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });
  </script>
</Layout>
