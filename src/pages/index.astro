---
import Layout from '../layouts/Layout.astro';
import { readdir } from 'node:fs/promises';
import path from 'node:path';

const imageExtensions = new Set(['.jpg', '.jpeg', '.png', '.webp', '.gif', '.avif', '.svg']);
const videoExtensions = new Set(['.mp4', '.webm', '.ogg', '.mov']);

let galleryMedia = [];

try {
  const galleryDir = new URL('../../public/gallery/', import.meta.url);
  const entries = await readdir(galleryDir, { withFileTypes: true });

  galleryMedia = entries
    .filter((entry) => entry.isFile())
    .map((entry) => {
      const extension = path.extname(entry.name).toLowerCase();
      const isImage = imageExtensions.has(extension);
      const isVideo = videoExtensions.has(extension);

      if (!isImage && !isVideo) return null;

      return {
        name: entry.name,
        src: `/gallery/${entry.name}`,
        type: isVideo ? 'video' : 'image',
        alt: path.parse(entry.name).name.replace(/[-_]+/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase())
      };
    })
    .filter(Boolean)
    .sort((a, b) => a.name.localeCompare(b.name));
} catch (error) {
  console.error('Unable to load media from public/gallery:', error);
}

const trips = [
  {
    id: 1,
    title: 'Big Game Drifting Tuna',
    startTime: '08:00am',
    image: 'tuna.jpg',
    description: 'Big Game drifting for Bluefin Tuna, built for anglers who want the most iconic fight in the Mediterranean.',
    features: ['Food & Drinks', 'Rod, Reel and Tackle', 'Max 4 person'],
    pricing: '8h – €750/group|6h – 600€/group|4h – €450/group'
  },
  {
    id: 2,
    title: 'Trolling Offshore',
    startTime: '08:00am',
    image: 'trolling.png',
    description: 'Offshore trolling for Bluefin Tuna, Swordfish, Albacore and big pelagics with a technical long-range approach.',
    features: ['Food & Drinks', 'Rod, Reel and Tackle', 'Max 4 person'],
    pricing: '8h — €900/group'
  },
  {
    id: 3,
    title: 'Trolling Inshore',
    startTime: '08:00am',
    image: 'inshore.jpg',
    description: 'Inshore trolling with a precise, technical approach to target seabass, mackerel and coastal predators.',
    features: ['Food & Drinks', 'Rod, Reel and Tackle', 'Max 4 person'],
    pricing: '8h – €750/group|6h – 600€/group|4h – €450/group'
  },
  {
    id: 4,
    title: 'Bottom Fishing',
    startTime: '08:00am',
    image: 'bottom.webp',
    description: 'Bottom fishing and bolentino focused on reading the seabed, structure and the best feeding zones.',
    features: ['Food & Drinks', 'Rod, Reel and Tackle', 'Max 4 person'],
    pricing: '8h – €750/group|6h – 600€/group|4h – €450/group'
  },
  {
    id: 5,
    title: 'Swordfish Night Fishing',
    startTime: '08:00pm',
    image: 'swordfish.webp',
    description: 'A dedicated night expedition for Swordfish with squid baiting, specialized gear and total darkness.',
    features: ['Food & Drinks', 'Rod, Reel and Tackle', 'Max 4 person'],
    pricing: '€1.500/group'
  },
  {
    id: 6,
    title: 'Octopus and Squid Fishing',
    startTime: '08:00am',
    image: 'octopus.jpg',
    description: 'A technical, patient session aimed at octopus and squid using classic and modern fishing methods.',
    features: ['Food & Drinks', 'Rod, Reel and Tackle', 'Max 4 person'],
    pricing: '8h – €750/group|6h – 600€/group|4h – €450/group'
  },
  {
    id: 7,
    title: 'Seabass Trolling',
    startTime: '08:00am',
    image: 'spigola.jpg',
    description: 'A coastal seabass session built around lures, bait, readings of the seabed and precise presentation.',
    features: ['Food & Drinks', 'Rod, Reel and Tackle', 'Max 4 person'],
    pricing: '8h – €750/group|6h – 600€/group|4h – €450/group'
  }
];

const faqEntries = [
  {
    question: 'Roma è un posto adatto alla pesca?',
    answer:
      'Il litorale romano, e in particolare il tratto di mare antistante la foce del Tevere, è uno dei "punti caldi" della pesca sportiva in Italia. La particolare conformazione dei fondali e l\'incontro tra le correnti d\'acqua dolce e quelle salate del Tirreno creano un ecosistema ricco di vita. Qui le rotte migratorie dei predatori, come il Tonno Rosso e l\'Aguglia Imperiale, rendono Roma una base strategica per il Big Game, la traina d\'altura e la pesca costiera.'
  },
  {
    question: 'Quali pesci posso pescare a Roma?',
    answer:
      'Tonno Rosso, Tonno Alletterato, Aguglia Imperiale, Tonno Alalunga, Pesce Spada, Lampuga, Leccia Amia, Pesce Serra, Polpi, Seppie, Orata e pesce di fondo.'
  },
  {
    question: 'Posso portare la mia attrezzatura?',
    answer:
      'Mettiamo a disposizione attrezzatura premium dei migliori brand mondiali (Giapponesi, Americani, Italiani). Se però hai una tua canna "fortunata", sei libero di portarla.'
  },
  {
    question: 'Cosa succede se non ho mai pescato prima?',
    answer:
      'Le nostre uscite sono aperte a tutti. Ti assisteremo passo dopo passo, insegnandoti le basi del combattimento e della gestione della preda.'
  },
  {
    question: 'Cosa succede in caso di maltempo?',
    answer:
      'La sicurezza è la nostra priorità. Se le condizioni meteo-marine non consentono l\'uscita, la prenotazione verrà spostata alla prima data utile. È possibile cancellare la prenotazione fino a 3 giorni prima.'
  },
  {
    question: 'Posso portare un accompagnatore che non pesca?',
    answer:
      'Certamente! La barca è spaziosa e perfetta anche per chi vuole solo godersi una giornata di sole e mare.'
  },
  {
    question: 'Cosa succede se prendiamo un pesce? Posso portarlo a casa?',
    answer:
      'Seguiamo rigorosamente le normative vigenti. Per il Tonno Rosso pratichiamo spesso il Catch & Release, mentre per altre specie è possibile tenere il pescato.'
  },
  {
    question: 'La cattura è garantita?',
    answer:
      'Il mare non è un acquario, ma la nostra esperienza e la strumentazione di bordo massimizzano le probabilità di successo. L\'emozione della caccia è parte integrante dell\'avventura.'
  },
  {
    question: 'I bambini sono accettati?',
    answer:
      'Certo che sì, sono il futuro della pesca!'
  }
];

const cardSchemes = [
  {
    bar: 'background:linear-gradient(to right,#22d3ee,#0ea5e9,#3b82f6)',
    titleGrad: "font-family:'Montserrat',sans-serif;color:#0f172a",
  },
];

const tripsWithSchemes = trips.map((trip, i) => ({ ...trip, s: cardSchemes[i % cardSchemes.length] }));
---

<Layout title="Charter Pesca Roma e Fiumicino | Big Catch Fishing Charters | Pesca Tonno, Traina, Drifting">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "LocalBusiness",
          "@id": "https://www.bigcatchfishingcharters.com/#business",
          "name": "Big Catch Fishing Charters",
          "description": "Charter pesca Roma e Fiumicino. Uscite di pesca al tonno rosso, pesce spada, drifting, traina offshore e inshore, bolentino nel Mar Tirreno.",
          "url": "https://www.bigcatchfishingcharters.com",
          "telephone": "+39-3793554548",
          "email": "bigcatchfishingcharters@gmail.com",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Viale Traiano 88",
            "addressLocality": "Fiumicino",
            "addressRegion": "RM",
            "postalCode": "00054",
            "addressCountry": "IT"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 41.7666,
            "longitude": 12.2333
          },
          "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
            "opens": "06:00",
            "closes": "22:00"
          },
          "sameAs": [],
          "image": "/og-image.jpg"
        }
      ]
    })} />
  </Fragment>

  <section class="relative flex min-h-[600px] items-center justify-center overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 sm:min-h-[700px]">
    <div class="absolute inset-0 z-0">
      <video src="/video-hero.mp4" autoplay muted loop playsinline class="h-full w-full object-cover opacity-40"></video>
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950/60 via-slate-950/40 to-slate-950/80"></div>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold leading-tight tracking-tight text-slate-50 sm:text-5xl lg:text-6xl">
        Rome Fishing Charters
      </h1>

      <p class="mt-3 text-sm text-slate-300 sm:text-base">
        More than 10 years fishing the coast's of Rome
      </p>

      <p class="mt-6 max-w-3xl text-base leading-relaxed text-slate-300 sm:text-lg">
        Embark on an unforgettable fishing adventure in Rome. Our charters are designed to deliver the best mixed fishing experience, from Bluefin Tuna and Swordfish to inshore seabass and bottom fishing. We focus on safety, local knowledge and memorable sea days.
      </p>

      <a
        href="https://wa.me/393793554548?text=Hi!%20I'm%20interested%20in%20booking%20a%20fishing%20trip%20with%20your%20charter.%20Could%20you%20please%20send%20me%20more%20info%20about%20your%20packages?"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 mb-8 inline-flex items-center gap-2 rounded-lg bg-green-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-green-600/30 transition-all hover:bg-green-500"
      >
        Book Now
      </a>
    </div>
  </section>

  <section id="trips" class="bg-gradient-to-b from-white to-sky-50/60 py-16 sm:py-20">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-cyan-500 to-sky-600 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-white shadow-md shadow-cyan-500/30">
          BOOK YOUR TRIP
        </span>
        <h2 class="mt-4 text-3xl font-black text-slate-900 sm:text-4xl" style="font-family:'Montserrat',sans-serif">
          Choose Your <span class="bg-gradient-to-r from-cyan-500 to-sky-600 bg-clip-text text-transparent">Adventure</span>
        </h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tripsWithSchemes.map((trip) => (
          <article class="group overflow-hidden rounded-2xl border border-slate-200 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-cyan-200 hover:shadow-lg hover:shadow-cyan-100/80">
            <button
              type="button"
              class="trip-card-trigger block w-full cursor-pointer text-left"
              data-trip-id={trip.id}
              data-title={trip.title}
              data-start-time={trip.startTime}
              data-image={trip.image}
              data-description={trip.description}
              data-features={trip.features.join('|')}
              data-pricing={trip.pricing}
              aria-label={`Open details for ${trip.title}`}
            >
              <div class="aspect-[4/3] overflow-hidden bg-slate-100">
                <img src={trip.image} alt={trip.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
              </div>

              <div class="h-2 w-full" style={trip.s.bar}></div>

              <div class="p-6">
                <h3 class="trip-card-title text-xl font-black" style={trip.s.titleGrad}>{trip.title}</h3>

                <div class="trip-card-pricing mt-2 flex flex-wrap gap-1">
                  {trip.pricing.split('|').map((p) => (
                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700 ring-1 ring-amber-200">
                      {p}
                    </span>
                  ))}
                </div>

                <p class="mt-3 text-sm text-slate-500">
                  <span class="trip-start-label">Start</span>
                  <span class="trip-start-time">{trip.startTime}</span>
                </p>

                <ul class="mt-4 space-y-2">
                  {trip.features.map((feature) => (
                    <li class="flex items-center gap-2 text-sm text-slate-600">
                      <span class="trip-feature-text">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div id="trip-modal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-slate-950/90 p-3 sm:p-4">
    <button
      type="button"
      id="trip-modal-close"
      class="absolute right-3 top-3 z-10 rounded-md border border-slate-300 bg-white/90 px-3 py-2 text-sm text-slate-700 transition hover:bg-slate-100 sm:right-4 sm:top-4"
      aria-label="Close trip details"
    >
      Close
    </button>

    <div class="flex max-h-[90dvh] w-full max-w-3xl flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
      <div class="min-h-0 flex-1 overflow-y-auto">
        <div class="space-y-3 p-4 sm:space-y-4 sm:p-6">
          <h3 id="trip-modal-title" class="text-xl font-semibold text-slate-900 sm:text-2xl"></h3>
          <p id="trip-modal-start" class="text-sm text-slate-500"></p>
          <div id="trip-modal-pricing" class="inline-flex items-center gap-2 rounded-xl bg-amber-50 px-4 py-2 text-sm font-bold text-amber-700 ring-1 ring-amber-200"></div>
          <div id="trip-modal-features" class="flex flex-wrap gap-2"></div>
          <p id="trip-modal-description" class="text-sm leading-relaxed text-slate-700"></p>
        </div>
      </div>
    </div>
  </div>

  <section id="gallery" class="bg-gradient-to-br from-sky-50 via-cyan-50 to-blue-50 py-16 sm:py-24">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-cyan-500 to-sky-600 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-white shadow-md shadow-cyan-500/30">
          Gallery
        </span>
        <h2 class="mt-4 text-3xl font-black text-slate-900 sm:text-4xl" style="font-family:'Montserrat',sans-serif; background:linear-gradient(135deg,#0891b2,#0369a1); -webkit-background-clip:text; color:transparent;">
          Moments at Sea
        </h2>
      </div>

      {galleryMedia.length > 0 ? (
        <div class="relative mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div id="gallery-carousel-track" class="flex transition-transform duration-500 ease-out">
            {galleryMedia.map((media, index) => (
              <button
                type="button"
                class="gallery-slide group relative flex-shrink-0 cursor-pointer text-left"
                data-index={index}
                data-src={media.src}
                data-type={media.type}
                data-alt={media.alt}
                aria-label={`Open ${media.type}: ${media.alt}`}
              >
                {media.type === 'video' ? (
                  <video
                    src={media.src}
                    class="aspect-[16/9] h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    muted
                    loop
                    autoplay
                    playsinline
                    preload="metadata"
                  />
                ) : (
                  <img src={media.src} alt={media.alt} class="aspect-[16/9] h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                )}
                <p class="border-t border-slate-100 px-4 py-3 text-sm text-slate-500">{media.alt}</p>
              </button>
            ))}
          </div>
        </div>
      ) : (
        <p class="mt-6 text-center text-slate-500">No files found in public/gallery.</p>
      )}
    </div>
  </section>

  <section id="faq" class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-amber-400 to-orange-500 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-white shadow-md shadow-orange-500/20">FAQ</span>
        <h2 id="faq-title" class="mt-4 text-3xl font-black text-slate-900 sm:text-4xl">Domande frequenti</h2>
      </div>

      <div id="faq-list" class="space-y-4">
        {faqEntries.map((item) => (
          <div class="faq-item rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="faq-question text-lg font-bold text-slate-900">{item.question}</h3>
            <p class="faq-answer mt-2 text-sm leading-relaxed text-slate-600">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const modal = document.getElementById('trip-modal');
    const modalTitle = document.getElementById('trip-modal-title');
    const modalStart = document.getElementById('trip-modal-start');
    const modalPricing = document.getElementById('trip-modal-pricing');
    const modalFeatures = document.getElementById('trip-modal-features');
    const modalDescription = document.getElementById('trip-modal-description');
    const closeButton = document.getElementById('trip-modal-close');

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    if (closeButton) {
      closeButton.addEventListener('click', closeModal);
    }

    document.querySelectorAll('.trip-card-trigger').forEach((button) => {
      button.addEventListener('click', () => {
        if (!modal || !modalTitle || !modalStart || !modalPricing || !modalFeatures || !modalDescription) return;

        const features = button.dataset.features ? button.dataset.features.split('|') : [];
        const pricing = button.dataset.pricing || '';

        modalTitle.textContent = button.dataset.title || '';
        modalStart.textContent = `Start: ${button.dataset.startTime || ''}`;
        modalPricing.textContent = pricing;
        modalDescription.textContent = button.dataset.description || '';
        modalFeatures.innerHTML = features
          .map((feature) => `<span class="rounded-full bg-sky-50 px-2 py-1 text-xs font-medium text-sky-700 ring-1 ring-sky-200">${feature}</span>`)
          .join('');

        modal.classList.remove('hidden');
        modal.classList.add('flex');
      });
    });

    modal?.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });
  </script>
</Layout>
