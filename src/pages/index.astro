				const pricingEl = card.querySelector('.trip-card-pricing');
				if (pricingEl && trip.pricing) {
					const svgIcon = `<svg class="h-3.5 w-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"/><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"/></svg>`;
					pricingEl.innerHTML = trip.pricing.split('|').map((p) =>
						`<span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700 ring-1 ring-amber-200">${svgIcon}${p}</span>`
					).join('');
				}

				const startLabel = card.querySelector('.trip-start-label');
				if (startLabel) startLabel.textContent = t.startLabel;

				const featureEls = card.querySelectorAll('.trip-feature-text');
				featureEls.forEach((el, index) => {
					if (trip.features[index]) el.textContent = trip.features[index];
				});
			});

			document.querySelectorAll('[data-faq-index]').forEach((detail) => {
				const idx = Number(detail.getAttribute('data-faq-index'));
				const q = detail.querySelector('summary span');
				const a = detail.querySelector('p');
				if (t.faq[idx]) {
					if (q) q.textContent = t.faq[idx][0];
					if (a) a.textContent = t.faq[idx][1];
				}
			});

			const closeTrip = document.getElementById('trip-modal-close');
			if (closeTrip) closeTrip.textContent = t.close;
			const tripBook = document.getElementById('trip-modal-book');
			if (tripBook) tripBook.textContent = t.heroBook;

			document.querySelectorAll('.lang-btn').forEach((btn) => {
				const isActive = btn.getAttribute('data-lang') === lang;
				btn.setAttribute('aria-selected', isActive.toString());
				if (isActive) {
					btn.classList.add('en-active', 'bg-gradient-to-r', 'from-cyan-500', 'to-sky-600', 'text-white', 'shadow-md');
					btn.classList.remove('text-cyan-700', 'hover:text-cyan-900');
				} else {
					btn.classList.remove('en-active', 'bg-gradient-to-r', 'from-cyan-500', 'to-sky-600', 'text-white', 'shadow-md', 'shadow-cyan-400/30', 'hover:from-cyan-400', 'hover:to-sky-500', 'bg-sky-500/90', 'shadow-lg', 'shadow-sky-500/20');
					btn.classList.add('text-cyan-700', 'hover:text-cyan-900');
				}
			});

			currentLang = lang;
		};

		document.querySelectorAll('.lang-btn').forEach((btn) => {
			btn.addEventListener('click', () => applyLang(btn.getAttribute('data-lang') || 'en'));
		});

		applyLang(currentLang);

		const track = document.getElementById('gallery-carousel-track');
		const prev = document.getElementById('gallery-prev');
		const next = document.getElementById('gallery-next');
		const slides = Array.from(document.querySelectorAll('.gallery-slide'));

		const lightbox = document.getElementById('gallery-lightbox');
		const lightboxContent = document.getElementById('gallery-lightbox-content');
		const lightboxCaption = document.getElementById('gallery-lightbox-caption');
		const closeButton = document.getElementById('gallery-lightbox-close');
		const prevButton = document.getElementById('gallery-lightbox-prev');
		const nextButton = document.getElementById('gallery-lightbox-next');

		if (track && prev && next && slides.length > 0) {
			let current = 0;
			let visibleCount = 1;

			const getVisibleCount = () => {
				if (window.innerWidth >= 1024) return 3;
				if (window.innerWidth >= 768) return 2;
				return 1;
			};

			const setSlideWidths = () => {
				visibleCount = getVisibleCount();
				slides.forEach((slide) => {
					slide.style.flex = `0 0 ${100 / visibleCount}%`;
				});
				const maxIndex = Math.max(0, slides.length - visibleCount);
				if (current > maxIndex) current = maxIndex;
			};

			const update = () => {
				track.style.transform = `translateX(-${current * (100 / visibleCount)}%)`;
			};

			prev.addEventListener('click', () => {
				const maxIndex = Math.max(0, slides.length - visibleCount);
				current = current <= 0 ? maxIndex : current - 1;
				update();
			});

			next.addEventListener('click', () => {
				const maxIndex = Math.max(0, slides.length - visibleCount);
				current = current >= maxIndex ? 0 : current + 1;
				update();
			});

			window.addEventListener('resize', () => {
				setSlideWidths();
				update();
			});

			setSlideWidths();
			update();
		}

		if (slides.length && lightbox && lightboxContent && lightboxCaption && closeButton && prevButton && nextButton) {
			let currentIndex = 0;

			const renderMedia = () => {
				const item = slides[currentIndex];
				const src = item.dataset.src || '';
				const type = item.dataset.type || 'image';
				const alt = item.dataset.alt || '';

				lightboxCaption.textContent = `${currentIndex + 1} / ${slides.length} • ${alt}`;
				lightboxContent.innerHTML = '';

				if (type === 'video') {
					const video = document.createElement('video');
					video.src = src;
					video.controls = true;
					video.autoplay = true;
					video.playsInline = true;
					video.className = 'max-h-[80vh] w-full object-contain';
					lightboxContent.appendChild(video);
				} else {
					const img = document.createElement('img');
					img.src = src;
					img.alt = alt;
					img.className = 'max-h-[80vh] w-full object-contain';
					lightboxContent.appendChild(img);
				}
			};

			const openLightbox = (index) => {
				currentIndex = index;
				renderMedia();
				lightbox.classList.remove('hidden');
				lightbox.classList.add('flex');
				document.body.style.overflow = 'hidden';
			};

			const closeLightbox = () => {
				lightbox.classList.add('hidden');
				lightbox.classList.remove('flex');
				lightboxContent.innerHTML = '';
				document.body.style.overflow = '';
			};

			const prevMedia = () => {
				currentIndex = (currentIndex - 1 + slides.length) % slides.length;
				renderMedia();
			};

			const nextMedia = () => {
				currentIndex = (currentIndex + 1) % slides.length;
				renderMedia();
			};

			slides.forEach((item, index) => {
				item.addEventListener('click', () => openLightbox(index));
			});

			closeButton.addEventListener('click', closeLightbox);
			prevButton.addEventListener('click', prevMedia);
			nextButton.addEventListener('click', nextMedia);

			lightbox.addEventListener('click', (event) => {
				if (event.target === lightbox) closeLightbox();
			});

			document.addEventListener('keydown', (event) => {
				if (lightbox.classList.contains('hidden')) return;
				if (event.key === 'Escape') closeLightbox();
				if (event.key === 'ArrowLeft') prevMedia();
				if (event.key === 'ArrowRight') nextMedia();
			});
		}

		const tripCards = Array.from(document.querySelectorAll('.trip-card-trigger'));
		const tripModal = document.getElementById('trip-modal');
		const tripModalClose = document.getElementById('trip-modal-close');
		const tripModalImage = document.getElementById('trip-modal-image');
		const tripModalTitle = document.getElementById('trip-modal-title');
		const tripModalStart = document.getElementById('trip-modal-start');
		const tripModalFeatures = document.getElementById('trip-modal-features');
		const tripModalDescription = document.getElementById('trip-modal-description');
		const tripModalBook = document.getElementById('trip-modal-book');
		const tripModalPricing = document.getElementById('trip-modal-pricing');

		if (
			tripCards.length &&
			tripModal &&
			tripModalClose &&
			tripModalImage &&
			tripModalTitle &&
			tripModalStart &&
			tripModalFeatures &&
			tripModalDescription &&
			tripModalBook
		) {
			const openTripModal = (card) => {
				const title = card.dataset.title || '';
				const startTime = card.dataset.startTime || '';
				const image = card.dataset.image || '';
				const description = card.dataset.description || '';
				const features = (card.dataset.features || '').split('|').filter(Boolean);
				const pricing = card.dataset.pricing || '';

				tripModalImage.src = image;
				tripModalImage.alt = title;
				tripModalTitle.textContent = title;
				tripModalStart.textContent = `${i18n[currentLang].startLabel} ${startTime}`;
				tripModalDescription.textContent = description;
				tripModalBook.href = `https://wa.me/393793554548?text=${encodeURIComponent(`Hi! I want to book ${title}`)}`;
				if (tripModalPricing) {
					const svgIcon = `<svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"/><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"/></svg>`;
					tripModalPricing.className = 'flex flex-wrap gap-1.5';
					tripModalPricing.innerHTML = pricing.split('|').map((p) =>
						`<span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 ring-1 ring-amber-200">${svgIcon}${p}</span>`
					).join('');
				}
				tripModalFeatures.innerHTML = '';
				features.forEach((feature) => {
					const chip = document.createElement('span');
					chip.className = 'inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold';
					chip.style.cssText = 'background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd';
					chip.innerHTML = `
						<svg class="h-3 w-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color:#0369a1">
							<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
						</svg>
						${feature}
					`;
					tripModalFeatures.appendChild(chip);
				});

				tripModal.classList.remove('hidden');
				tripModal.classList.add('flex');
				document.body.style.overflow = 'hidden';
			};

			const closeTripModal = () => {
				tripModal.classList.add('hidden');
				tripModal.classList.remove('flex');
				document.body.style.overflow = '';
			};

			tripCards.forEach((card) => {
				card.addEventListener('click', () => openTripModal(card));
			});

			tripModalClose.addEventListener('click', closeTripModal);
			tripModal.addEventListener('click', (event) => {
				if (event.target === tripModal) closeTripModal();
			});

			document.addEventListener('keydown', (event) => {
				if (!tripModal.classList.contains('hidden') && event.key === 'Escape') {
					closeTripModal();
				}
			});
		}
	</script>

</Layout>
