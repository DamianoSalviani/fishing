const formatTime = (time, lang) => {
  if (lang === 'it') return time;
  const [h, m] = time.split(':').map(Number);
  return `${h % 12 === 0 ? 12 : h % 12}:${String(m).padStart(2, '0')} ${h >= 12 ? 'PM' : 'AM'}`;
};

const formatPricing = (entries, lang) =>
  entries.map((entry) => {
    const [a, b] = entry.split('|');
    const unit = lang === 'it' ? 'gruppo' : 'group';
    return b ? `${a} – €${b}/${unit}` : `€${a}/${unit}`;
  });

const trips = tripsBase.map((base) => {
  const i18n = {};
  for (const lang of ['en', 'it']) {
    i18n[lang] = {
      ...tripTexts[base.id][lang],
      startTime: formatTime(base.time, lang),
      features: featuresText[lang],
      pricing: formatPricing(base.pricing, lang)
    };
  }
  return { id: base.id, image: base.image, i18n, ...i18n.en };
});

