const timeIt = (time) => {
  const match = /^(\d{1,2}):(\d{2})\s*(am|pm)$/i.exec(time);
  if (!match) return time;
  const hours = (Number(match[1]) % 12) + (match[3].toLowerCase() === 'pm' ? 12 : 0);
  return `${String(hours).padStart(2, '0')}:${match[2]}`;
};

