---
import Layout from '../layouts/Layout.astro';
import { readdir } from 'node:fs/promises';
import path from 'node:path';

const imageExtensions = new Set(['.jpg', '.jpeg', '.png', '.webp', '.gif', '.avif', '.svg']);
const videoExtensions = new Set(['.mp4', '.webm', '.ogg', '.mov']);

let galleryMedia = [];

try {
  const galleryDir = new URL('../../public/gallery/', import.meta.url);
  const entries = await readdir(galleryDir, { withFileTypes: true });

  galleryMedia = entries
    .filter((entry) => entry.isFile())
    .map((entry) => {
      const extension = path.extname(entry.name).toLowerCase();
      const isImage = imageExtensions.has(extension);
      const isVideo = videoExtensions.has(extension);

      if (!isImage && !isVideo) return null;

      return {
        name: entry.name,
        src: `/gallery/${entry.name}`,
        type: isVideo ? 'video' : 'image',
        alt: path.parse(entry.name).name.replace(/[-_]+/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase())
      };
    })
    .filter(Boolean)
    .sort((a, b) => a.name.localeCompare(b.name));
} catch (error) {
  console.error('Unable to load media from public/gallery:', error);
}

const trips = [
  {
    id: 1,
    title: 'Big Game Drifting Tuna',
    startTime: '08:00am',
    image: 'tuna.jpg',
    description: 'Big Game drifting for Bluefin Tuna, built for anglers who want the most iconic fight in the Mediterranean.',
    features: ['Food & Drinks', 'Rod, Reel and Tackle', 'Max 4 person'],
    pricing: '8h – €750/group|6h – 600€/group|4h – €450/group'
  }
];

const faqEntries = [
  {
    question: 'Roma è un posto adatto alla pesca?',
    answer:
      'Il litorale romano, e in particolare il tratto di mare antistante la foce del Tevere, è uno dei "punti caldi" della pesca sportiva in Italia. La particolare conformazione dei fondali e l\'incontro tra le correnti d\'acqua dolce e quelle salate del Tirreno creano un ecosistema ricco di vita. Qui le rotte migratorie dei predatori, come il Tonno Rosso e l\'Aguglia Imperiale, rendono Roma una base strategica per il Big Game, la traina d\'altura e la pesca costiera.'
  },
  {
    question: 'Quali pesci posso pescare a Roma?',
    answer:
      'Tonno Rosso, Tonno Alletterato, Aguglia Imperiale, Tonno Alalunga, Pesce Spada, Lampuga, Leccia Amia, Pesce Serra, Polpi, Seppie, Orata e pesce di fondo.'
  },
  {
    question: 'Posso portare la mia attrezzatura?',
    answer:
      'Mettiamo a disposizione attrezzatura premium dei migliori brand mondiali (Giapponesi, Americani, Italiani). Se però hai una tua canna "fortunata", sei libero di portarla.'
  },
  {
    question: 'Cosa succede se non ho mai pescato prima?',
    answer:
      'Le nostre uscite sono aperte a tutti. Ti assisteremo passo dopo passo, insegnandoti le basi del combattimento e della gestione della preda.'
  },
  {
    question: 'Cosa succede in caso di maltempo?',
    answer:
      'La sicurezza è la nostra priorità. Se le condizioni meteo-marine non consentono l\'uscita, la prenotazione verrà spostata alla prima data utile. È possibile cancellare la prenotazione fino a 3 giorni prima.'
  },
  {
    question: 'Posso portare un accompagnatore che non pesca?',
    answer:
      'Certamente! La barca è spaziosa e perfetta anche per chi vuole solo godersi una giornata di sole e mare.'
  },
  {
    question: 'Cosa succede se prendiamo un pesce? Posso portarlo a casa?',
    answer:
      'Seguiamo rigorosamente le normative vigenti. Per il Tonno Rosso pratichiamo spesso il Catch & Release, mentre per altre specie è possibile tenere il pescato.'
  },
  {
    question: 'La cattura è garantita?',
    answer:
      'Il mare non è un acquario, ma la nostra esperienza e la strumentazione di bordo massimizzano le probabilità di successo. L\'emozione della caccia è parte integrante dell\'avventura.'
  },
  {
    question: 'I bambini sono accettati?',
    answer:
      'Certo che sì, sono il futuro della pesca!'
  }
];
---

<Layout title="Big Catch Fishing Charters">
  <main>
    <section class="bg-slate-950 text-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.3em] text-cyan-400">Big Catch Fishing Charters</p>
            <h1 class="mt-4 text-4xl font-black tracking-tight sm:text-5xl">Roma e Fiumicino: pesca tra mare, adrenalina e avventura</h1>
            <p class="mt-6 max-w-xl text-lg text-slate-300">
              Uscite di pesca sportive, professionali e memorabili sul Tirreno, pensate per chi vuole vivere il mare come un vero avventuriero.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="#trips" class="rounded-full bg-cyan-500 px-6 py-3 font-bold text-slate-950 transition hover:bg-cyan-400">Prenota ora</a>
              <a href="#faq" class="rounded-full border border-white/20 bg-white/5 px-6 py-3 font-bold text-white transition hover:bg-white/10">FAQ</a>
            </div>
          </div>

          <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-3 shadow-2xl shadow-cyan-500/20">
            <img src="/gallery/hero.jpg" alt="Pesca in barca a Roma" class="h-[420px] w-full rounded-2xl object-cover" />
          </div>
        </div>
      </div>
    </section>

    <section id="trips" class="py-16 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
          <p class="text-sm font-bold uppercase tracking-[0.3em] text-cyan-600">Uscite</p>
          <h2 class="mt-3 text-3xl font-black text-slate-900 sm:text-4xl">Scegli la tua avventura</h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {trips.map((trip) => (
            <article class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-lg shadow-slate-200/60">
              <img src={`/gallery/${trip.image}`} alt={trip.title} class="h-56 w-full object-cover" />
              <div class="p-6">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-xl font-black text-slate-900">{trip.title}</h3>
                  <span class="rounded-full bg-cyan-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-cyan-700">{trip.startTime}</span>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-slate-600">{trip.description}</p>
                <ul class="mt-4 space-y-2 text-sm text-slate-700">
                  {trip.features.map((feature) => (
                    <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-cyan-500"></span>{feature}</li>
                  ))}
                </ul>
                <div class="mt-6 flex items-center justify-between border-t border-slate-200 pt-4">
                  <span class="text-base font-black text-slate-900">{trip.pricing}</span>
                  <a href="#contact" class="rounded-full bg-slate-900 px-4 py-2 text-sm font-bold text-white transition hover:bg-cyan-600">Richiedi</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="faq" class="bg-slate-50 py-16 sm:py-20">
      <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
          <span class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-amber-400 to-orange-500 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-white shadow-md shadow-orange-500/20">FAQ</span>
          <h2 id="faq-title" class="mt-4 text-3xl font-black text-slate-900 sm:text-4xl">Domande frequenti</h2>
        </div>

        <div id="faq-list" class="space-y-4">
          {faqEntries.map((item) => (
            <div class="faq-item rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <h3 class="faq-question text-lg font-bold text-slate-900">{item.question}</h3>
              <p class="faq-answer mt-2 text-sm leading-relaxed text-slate-600">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="gallery" class="bg-gradient-to-br from-sky-50 via-cyan-50 to-blue-50 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
          <p class="text-sm font-bold uppercase tracking-[0.3em] text-cyan-600">Gallery</p>
          <h2 class="mt-3 text-3xl font-black text-slate-900 sm:text-4xl">Momenti in mare</h2>
        </div>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {galleryMedia.slice(0, 6).map((media) => (
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
              {media.type === 'video' ? (
                <video src={media.src} class="h-64 w-full object-cover" muted playsinline controls />
              ) : (
                <img src={media.src} alt={media.alt} class="h-64 w-full object-cover" />
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="bg-slate-900 py-16 text-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 md:grid-cols-2">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.3em] text-cyan-400">Contatti</p>
            <h2 class="mt-3 text-3xl font-black sm:text-4xl">Prenota la tua uscita</h2>
            <p class="mt-4 max-w-lg text-slate-300">
              Scrivici per organizzare una giornata di pesca su misura, con consigli su pesca sportiva, attrezzatura e migliori zone di mare di Roma.
            </p>
          </div>

          <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <ul class="space-y-4 text-sm text-slate-200">
              <li><strong>Email:</strong> bigcatchfishingcharters@gmail.com</li>
              <li><strong>Telefono:</strong> +39 393793554548</li>
              <li><strong>Partenza:</strong> Roma e Fiumicino</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
