  }
];

const cardSchemes = [
  {
    bar: 'background:linear-gradient(to right,#22d3ee,#0ea5e9,#3b82f6)',
    titleGrad: "font-family:'Montserrat',sans-serif;color:#0f172a",
  },
];

const tripsWithSchemes = trips.map((trip, i) => ({ ...trip, s: cardSchemes[i % cardSchemes.length] }));
---

<Layout title="Big Catch Fishing Charters | Charter pesca Roma e Fiumicino">
  <section id="home" class="relative flex min-h-[620px] items-center justify-center overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 sm:min-h-[720px]">
