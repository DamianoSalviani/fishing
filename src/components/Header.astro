---
const menuItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Gallery', href: '#gallery' },
	{ label: 'Contatti', href: '#contact' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-slate-800 bg-slate-950/90 backdrop-blur">
	<input id="mobile-menu" type="checkbox" class="peer sr-only md:hidden" aria-label="Apri menu" />

	<div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
		<a href="/" class="flex items-center gap-3">
			<img src="/logo.png" alt="Big Catch Logo" class="h-10 w-10 sm:h-12 sm:w-12" />
			<span class="text-base font-bold tracking-tight text-slate-100 sm:text-lg">Big Catch Fishing Charters</span>
		</a>

		<label
			for="mobile-menu"
			class="inline-flex cursor-pointer items-center rounded-md border border-slate-700 p-2 text-slate-200 transition hover:bg-slate-800 md:hidden"
		>
			<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</label>

		<nav class="hidden items-center gap-6 md:flex" aria-label="Navigazione principale">
			{
				menuItems.map((item) => (
					<a href={item.href} class="text-sm font-medium text-slate-300 transition hover:text-sky-400">
						{item.label}
					</a>
				))
			}
		</nav>
	</div>

	<nav
		class="max-h-0 overflow-hidden border-t border-slate-800 bg-slate-950 transition-all duration-300 peer-checked:max-h-80 md:hidden"
		aria-label="Navigazione mobile"
	>
		<ul class="space-y-1 px-4 py-3 sm:px-6">
			{
				menuItems.map((item) => (
					<li>
						<a href={item.href} class="mobile-nav-link block rounded-md px-3 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-sky-400">
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script>
	const mobileMenuCheckbox = document.getElementById('mobile-menu') as HTMLInputElement | null;
	const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

	if (mobileMenuCheckbox && mobileNavLinks.length > 0) {
		mobileNavLinks.forEach((link) => {
			link.addEventListener('click', () => {
				mobileMenuCheckbox.checked = false;
			});
		});
	}
</script>
