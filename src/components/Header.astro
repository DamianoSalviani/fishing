---
const menuItems = [
	{ key: 'home', label: 'Home', href: '/#' },
	{ key: 'trips', label: 'Trips', href: '/#trips' },
	{ key: 'vessel', label: 'Vessel', href: '/#vessel' },
	{ key: 'faq', label: 'FAQ', href: '/#faq' },
	{ key: 'gallery', label: 'Gallery', href: '/#gallery' },
	{ key: 'contact', label: 'Contact', href: '/#contact' },
];
---

<header class="sticky top-0 z-50 w-full border-b-2 border-cyan-500/30 bg-white/95 shadow-sm backdrop-blur">
	<input id="mobile-menu" type="checkbox" class="peer sr-only md:hidden" aria-label="Apri menu" />

	<div class="mx-auto flex w-full max-w-6xl items-center px-4 py-3 sm:px-6 lg:px-8">
		<a href="/" class="flex items-center gap-3">
			<img src="/logo.png" alt="Big Catch Logo" class="h-10 w-10 sm:h-12 sm:w-12" />
			<span class="text-base font-black tracking-tight sm:text-lg" style="font-family:'Montserrat',sans-serif;background:linear-gradient(135deg,#0891b2,#0369a1);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Big Catch Fishing Charters</span>
		</a>

		<nav class="hidden items-center gap-6 md:flex md:flex-grow md:justify-center lg:gap-8" aria-label="Navigazione principale">
			{
				menuItems.map((item) => (
					<a href={item.href} data-nav-key={item.key} class="text-sm font-semibold text-slate-600 transition-all hover:text-cyan-600 hover:underline hover:underline-offset-4 hover:decoration-cyan-400">
						{item.label}
					</a>
				))
			}
		</nav>

		<!-- Language Switcher + Menu Button (Right side) -->
		<div class="flex items-center gap-3 ml-auto">
			<div class="inline-flex items-center rounded-full border-2 border-cyan-200 bg-cyan-50 p-1" id="lang-switcher" role="tablist">
				<button 
					type="button" 
					data-lang="en" 
					role="tab"
					aria-selected="true"
					class="lang-btn rounded-full px-4 py-2 text-xs font-bold transition-all duration-200 ease-out en-active bg-gradient-to-r from-cyan-500 to-sky-600 text-white shadow-md shadow-cyan-400/30 hover:from-cyan-400 hover:to-sky-500" 
				>
					EN
				</button>
				<button 
					type="button" 
					data-lang="it" 
					role="tab"
					aria-selected="false"
					class="lang-btn rounded-full px-4 py-2 text-xs font-bold transition-all duration-200 ease-out text-cyan-700 hover:text-cyan-900" 
				>
					IT
				</button>
			</div>

			<label
				for="mobile-menu"
				class="inline-flex cursor-pointer items-center rounded-md border border-slate-300 p-2 text-slate-600 transition hover:bg-slate-100 md:hidden"
			>
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</label>
		</div>
	</div>

	<nav
		class="max-h-0 overflow-hidden border-t border-slate-200 bg-white transition-all duration-300 peer-checked:max-h-80 md:hidden"
		aria-label="Navigazione mobile"
	>
		<ul class="space-y-1 px-4 py-3 sm:px-6">
			{
				menuItems.map((item) => (
					<li>
						<a href={item.href} data-nav-key={item.key} class="mobile-nav-link block rounded-md px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-cyan-50 hover:text-cyan-700">
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script>
	const mobileMenuCheckbox = document.getElementById('mobile-menu') as HTMLInputElement | null;
	const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

	if (mobileMenuCheckbox && mobileNavLinks.length > 0) {
		mobileNavLinks.forEach((link) => {
			link.addEventListener('click', () => {
				mobileMenuCheckbox.checked = false;
			});
		});
	}
</script>
