---
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-slate-900/60">
	<div class="mx-auto grid w-full max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-2 lg:px-8">
		<div>
			<h3 id="footer-links-title" class="text-sm font-semibold uppercase tracking-wide text-slate-100">Link utili</h3>
			<ul class="mt-3 space-y-2 text-sm text-slate-400">
				<li><a href="/#" data-footer-link-key="home" class="transition hover:text-sky-400">Home</a></li>
				<li><a href="/#trips" data-footer-link-key="trips" class="transition hover:text-sky-400">Uscite</a></li>
				<li><a href="/#vessel" data-footer-link-key="vessel" class="transition hover:text-sky-400">Imbarcazione</a></li>
				<li><a href="/#faq" data-footer-link-key="faq" class="transition hover:text-sky-400">FAQ</a></li>
				<li><a href="/#gallery" data-footer-link-key="gallery" class="transition hover:text-sky-400">Gallery</a></li>
				<li><a href="/#contact" data-footer-link-key="contact" class="transition hover:text-sky-400">Contatti</a></li>
			</ul>
		</div>

		<div id="contact">
			<h3 id="footer-contact-title" class="text-sm font-semibold uppercase tracking-wide text-slate-100">Contatti</h3>
			<ul class="mt-3 space-y-2 text-sm text-slate-400">
				<li>
					<span id="footer-email-label">Email</span>:
					<a
						href="mailto:info@fishingproject.it?subject=Richiesta%20informazioni%20uscita%20di%20pesca&body=Ciao%2C%20vorrei%20ricevere%20maggiori%20informazioni%20sulle%20uscite.%20Grazie."
						class="font-medium text-sky-300 underline decoration-sky-400/70 underline-offset-4 transition hover:text-sky-200 hover:decoration-sky-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/60 rounded-sm"
					>
						info@fishingproject.it
					</a>
				</li>
				<li>
					<span id="footer-phone-label">Telefono</span>:
					<a href="tel:+390123456789" class="font-medium text-sky-300 underline decoration-sky-400/70 underline-offset-4 transition hover:text-sky-200 hover:decoration-sky-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/60 rounded-sm">+39 0123 456789</a>
				</li>
				<li><span id="footer-address-label">Indirizzo</span>: <span id="footer-address-value">Via del Porto 10, Napoli</span></li>
			</ul>
			<div class="mt-4 flex gap-4">
				<a 
					href="https://wa.me/390000000000" 
					target="_blank" 
					rel="noreferrer" 
					class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-700 bg-slate-800/50 text-slate-400 transition hover:border-green-500/50 hover:bg-green-500/10 hover:text-green-400"
					aria-label="WhatsApp"
				>
					<i class="fab fa-whatsapp text-lg"></i>
				</a>
				<a 
					href="https://instagram.com/your-profile" 
					target="_blank" 
					rel="noreferrer" 
					class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-700 bg-slate-800/50 text-slate-400 transition hover:border-pink-500/50 hover:bg-pink-500/10 hover:text-pink-400"
					aria-label="Instagram"
				>
					<i class="fab fa-instagram text-lg"></i>
				</a>
			</div>
		</div>
	</div>
	<div id="footer-copyright" class="border-t border-slate-800 py-4 text-center text-xs text-slate-500">
		© {year} Fishing Project. Tutti i diritti riservati.
	</div>
</footer>
