---
import { getTranslation, type Language } from '../utils/i18n';

const { lang } = Astro.props as { lang: Language };
const t = (key: string) => getTranslation(lang, key);
const home = lang === 'it' ? '/it/' : '/';
const year = new Date().getFullYear();
---

<footer class="border-t-4 border-cyan-500 bg-gradient-to-br from-slate-900 to-sky-950">
	<div class="mx-auto grid w-full max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-2 lg:px-8">
		<div>
			<h3 id="footer-links-title" data-i18n="footer.links" class="text-sm font-black uppercase tracking-widest text-cyan-300">{t('footer.links')}</h3>
			<ul class="mt-3 space-y-2 text-sm text-slate-300">
				<li><a href={`${home}#`} data-footer-link-key="home" data-i18n="home" class="transition hover:text-cyan-400">{t('home')}</a></li>
				<li><a href={`${home}#trips`} data-footer-link-key="trips" data-i18n="footer.trips" class="transition hover:text-cyan-400">{t('footer.trips')}</a></li>
				<li><a href={`${home}#vessel`} data-footer-link-key="vessel" data-i18n="footer.vessel" class="transition hover:text-cyan-400">{t('footer.vessel')}</a></li>
				<li><a href={`${home}#faq`} data-footer-link-key="faq" data-i18n="faq" class="transition hover:text-cyan-400">{t('faq')}</a></li>
				<li><a href={`${home}#gallery`} data-footer-link-key="gallery" data-i18n="gallery" class="transition hover:text-cyan-400">{t('gallery')}</a></li>
				<li><a href={`${home}#contact`} data-footer-link-key="contact" data-i18n="contact" class="transition hover:text-cyan-400">{t('contact')}</a></li>
			</ul>
		</div>

		<div id="contact">
			<h3 id="footer-contact-title" data-i18n="footer.contact" class="text-sm font-black uppercase tracking-widest text-cyan-300">{t('footer.contact')}</h3>
			<ul class="mt-3 space-y-2 text-sm text-slate-300">
				<li>
					<span id="footer-email-label">Email</span>:
					<a
						href="mailto:bigcatchfishingcharters@gmail.com?subject=Richiesta%20informazioni%20uscita%20di%20pesca&body=Ciao%2C%20vorrei%20ricevere%20maggiori%20informazioni%20sulle%20uscite.%20Grazie."
					class="font-medium text-sky-600 underline decoration-sky-500/70 underline-offset-4 transition hover:text-sky-700 hover:decoration-sky-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500/60 rounded-sm"
					>
						bigcatchfishingcharters@gmail.com
					</a>
				</li>
				<li>
					<span id="footer-phone-label" data-i18n="footer.phone">{t('footer.phone')}</span>:
					<a href="tel:+393793554548" class="font-medium text-cyan-400 underline decoration-cyan-500/70 underline-offset-4 transition hover:text-cyan-300 rounded-sm">+39 3793554548</a>
				</li>
				<li><span id="footer-address-label" data-i18n="footer.address">{t('footer.address')}</span>: <span id="footer-address-value">Viale Traiano 88, Fiumicino (RM)</span></li>
			</ul>
			<div class="mt-4">
				<a 
					href="https://wa.me/393793554548" 
					target="_blank" 
					rel="noreferrer" 
					class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-green-500/30 bg-green-500/10 text-green-400 transition hover:bg-green-500/20 hover:text-green-300"
					aria-label="WhatsApp"
				>
					<i class="fab fa-whatsapp text-lg"></i>
				</a>
<a
  href="mailto:bigcatchfishingcharters@gmail.com"
  class="ml-2 inline-flex h-10 w-10 items-center justify-center rounded-full border border-green-500/30 bg-green-500/10 text-green-400 transition hover:bg-green-500/20 hover:text-green-300"
  aria-label="Scrivi un'email"
>
  <i class="fas fa-envelope text-lg"></i>
</a>
			</div>
		</div>
	</div>
	<div class="border-t border-slate-700 py-4 text-center text-xs text-slate-500">
		<p id="footer-copyright">© {year} Big Catch Fishing Charters. <span data-i18n="footer.copyright">{t('footer.copyright')}</span></p>
		<a href="/privacy" class="mt-1 inline-block text-cyan-400 underline underline-offset-2 transition hover:text-cyan-300" id="footer-privacy-link">Privacy Policy & Cookie Policy</a>
	</div>
</footer>
