---
import Layout from '../layouts/Layout.astro';
import { getTranslation, tripTranslations } from '../utils/i18n';
import { getImageAlt } from '../utils/imageAlt';
import { readdir } from 'node:fs/promises';
import path from 'node:path';

const siteUrl = Astro.site ?? new URL('https://www.bigcatchfishingcharter.com/');
const lang = Astro.url.pathname === '/it' || Astro.url.pathname === '/it/' ? 'it' : 'en';
const t = (key: string) => getTranslation(lang, key);

const imageExtensions = new Set(['.jpg', '.jpeg', '.png', '.webp', '.gif', '.avif', '.svg']);
const videoExtensions = new Set(['.mp4', '.webm', '.ogg', '.mov']);
const brandExtensions = new Set(['.jpg', '.jpeg', '.png', '.webp', '.gif', '.avif', '.svg']);

let galleryMedia = [];
let brandLogos = [];

try {
  const galleryDir = new URL('../../public/gallery/', import.meta.url);
  const entries = await readdir(galleryDir, { withFileTypes: true });

  galleryMedia = entries
    .filter((entry) => entry.isFile())
    .map((entry) => {
      const extension = path.extname(entry.name).toLowerCase();
      const isImage = imageExtensions.has(extension);
      const isVideo = videoExtensions.has(extension);

      if (!isImage && !isVideo) return null;

      return {
        name: entry.name,
        src: `/gallery/${entry.name}`,
        type: isVideo ? 'video' : 'image',
        alt: path.parse(entry.name).name.replace(/[-_]+/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase())
      };
    })
    .filter(Boolean)
    .sort((a, b) => a.name.localeCompare(b.name));
} catch (error) {
  console.error('Unable to load media from public/gallery:', error);
}

try {
  const brandsDir = new URL('../../public/brands/', import.meta.url);
  const entries = await readdir(brandsDir, { withFileTypes: true });

  brandLogos = entries
    .filter((entry) => entry.isFile())
    .map((entry) => {
      const extension = path.extname(entry.name).toLowerCase();
      if (!brandExtensions.has(extension)) return null;

      return {
        name: entry.name,
        src: `/brands/${entry.name}`,
        alt: path.parse(entry.name).name.replace(/[-_]+/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase())
      };
    })
    .filter(Boolean)
    .sort((a, b) => a.name.localeCompare(b.name));
} catch (error) {
  console.error('Unable to load brand logos from public/brands:', error);
}

