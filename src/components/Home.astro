      id="trip-modal-close"
      data-i18n="modal.close"
      class="absolute right-3 top-3 z-10 rounded-md border border-slate-300 bg-white/90 px-3 py-2 text-sm text-slate-700 transition hover:bg-slate-100 sm:right-4 sm:top-4"
      aria-label="Close trip details"
    >{t('modal.close')}</button>

    <div class="flex max-h-[90dvh] w-full max-w-3xl flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
      <div class="min-h-0 flex-1 overflow-y-auto">
        <div class="space-y-3 p-4 sm:space-y-4 sm:p-6">
          <h3 id="trip-modal-title" class="text-xl font-semibold text-slate-900 sm:text-2xl"></h3>
          <p id="trip-modal-start" class="text-sm text-slate-500"><span data-i18n="trips.start">{t('trips.start')}</span>: <span id="trip-modal-start-time"></span></p>
          <div id="trip-modal-pricing" class="inline-flex items-center gap-2 rounded-xl bg-amber-50 px-4 py-2 text-sm font-bold text-amber-700 ring-1 ring-amber-200"></div>
          <div id="trip-modal-features" class="flex flex-wrap gap-2"></div>
          <p id="trip-modal-description" class="text-sm leading-relaxed text-slate-700"></p>
<a
  href="https://wa.me/393793554548"
  target="_blank"
  rel="noopener noreferrer"
  data-i18n="hero.book"
  class="inline-flex rounded-lg bg-green-600 px-8 py-3.5 font-semibold uppercase text-white hover:bg-green-500"
>{t('hero.book')}</a>
        </div>
      </div>
    </div>
  </div>

  <section id="brands" class="border-y border-slate-200 bg-white py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 text-center">
        <span data-i18n="brands.badge" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-slate-800 to-slate-600 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-white shadow-md shadow-slate-900/20">{t('brands.badge')}</span>
        <h2 class="mt-4 text-3xl font-black text-slate-900 sm:text-4xl" style="font-family:'Montserrat',sans-serif">
          <span data-i18n="brands.heading">{t('brands.heading')}</span> <span data-i18n="brands.marks" class="text-slate-700">{t('brands.marks')}</span>
        </h2>
      </div>

      {brandLogos.length > 0 ? (
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-6 shadow-sm sm:px-6">
          <div class="brand-marquee-track flex w-max min-w-full items-center gap-6 sm:gap-8">
            {[...brandLogos, ...brandLogos].map((brand, index) => (
              <div class="brand-item flex items-center justify-center rounded-xl border border-slate-200 bg-white p-3 shadow-sm" key={`${brand.name}-${index}`}>
                <img src={brand.src} alt={getImageAlt('brands', brand.name, lang, brand.alt)} class="h-16 w-auto max-w-[160px] object-contain sm:h-20" loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      ) : (
        <p class="mt-6 text-center text-slate-500">
          <span data-i18n="brands.empty">{t('brands.empty')}</span> <span class="font-semibold">public/brands</span>. <span data-i18n="brands.add">{t('brands.add')}</span>
        </p>
      )}
    </div>
  </section>

  <section id="gallery" class="bg-gradient-to-br from-sky-50 via-cyan-50 to-blue-50 py-16 sm:py-24">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <span data-i18n="gallery.badge" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-cyan-500 to-sky-600 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-white shadow-md shadow-cyan-500/30">{t('gallery.badge')}</span>
        <h2 class="mt-4 text-3xl font-black text-slate-900 sm:text-4xl" style="font-family:'Montserrat',sans-serif; background:linear-gradient(135deg,#0891b2,#0369a1); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">
          <span data-i18n="gallery.heading">{t('gallery.heading')}</span>
        </h2>
      </div>

      {galleryMedia.length > 0 ? (
        <div class="relative mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white/80 shadow-sm">
          <div
            id="gallery-carousel-track"
            class="flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-smooth pb-3 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
          >
            {galleryMedia.map((media, index) => (
              <button
                type="button"
                class="gallery-slide group relative shrink-0 snap-center overflow-hidden rounded-xl border border-slate-200 bg-slate-100 text-left shadow-sm transition hover:shadow-md"
                data-index={index}
                data-src={media.src}
                data-type={media.type}
                data-alt={media.alt}
                aria-label={`Open ${media.type}: ${media.alt}`}
                style="width: min(58vw, 300px);"
              >
                {media.type === 'video' ? (
                  <video
                    src={media.src}
                    class="aspect-[4/3] h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    muted
                    loop
                    playsinline
                    preload="metadata"
                  />
                ) : (
                  <img src={media.src} alt={getImageAlt('gallery', media.name, lang, media.alt)} class="aspect-[4/3] h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                )}
                <p class="border-t border-slate-100 bg-white/90 px-3 py-2 text-xs font-medium text-slate-600 backdrop-blur-sm">{media.alt}</p>
              </button>
            ))}
          </div>
        </div>
      ) : (
        <p data-i18n="gallery.empty" class="mt-6 text-center text-slate-500">{t('gallery.empty')}</p>
      )}
    </div>
  </section>

  <section id="faq" class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-amber-400 to-orange-500 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-white shadow-md shadow-amber-500/30">
          FAQ
        </span>
        <h2 id="faq-title" data-i18n="faq.heading" class="mt-4 text-3xl font-black text-slate-900 sm:text-4xl">{t('faq.heading')}</h2>
      </div>

      <div id="faq-list" class="space-y-4">
        {faqEntries.map((item, index) => (
          <div class="faq-item rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="faq-question text-lg font-bold text-slate-900" data-i18n={`faq.${index}.question`}>{t(`faq.${index}.question`)}</h3>
            <p class="faq-answer mt-2 text-sm leading-relaxed text-slate-600" data-i18n={`faq.${index}.answer`}>{t(`faq.${index}.answer`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    @keyframes brand-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    .brand-marquee-track {
      animation: brand-scroll 26s linear infinite;
      will-change: transform;
    }

    .brand-marquee-track:hover {
      animation-play-state: paused;
    }

    .brand-item {
      flex: 0 0 auto;
      width: clamp(140px, 18vw, 220px);
      min-height: 96px;
    }
  </style>

  <script>
    const modal = document.getElementById('trip-modal');
    const modalTitle = document.getElementById('trip-modal-title');
    const modalStartTime = document.getElementById('trip-modal-start-time');
    const modalPricing = document.getElementById('trip-modal-pricing');
    const modalFeatures = document.getElementById('trip-modal-features');
    const modalDescription = document.getElementById('trip-modal-description');
    const closeButton = document.getElementById('trip-modal-close');

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    if (closeButton) {
      closeButton.addEventListener('click', closeModal);
    }

    document.querySelectorAll('.trip-card-trigger').forEach((button) => {
      button.addEventListener('click', () => {
        if (!modal || !modalTitle || !modalStartTime || !modalPricing || !modalFeatures || !modalDescription) return;

        const features = button.dataset.features ? button.dataset.features.split('|') : [];
        const pricing = button.dataset.pricing || '';

        modalTitle.textContent = button.dataset.title || '';
        modalStartTime.textContent = button.dataset.startTime || '';
        modalPricing.textContent = pricing;
        modalDescription.textContent = button.dataset.description || '';
        modalFeatures.innerHTML = features
          .map((feature) => `<span class="rounded-full bg-sky-50 px-2 py-1 text-xs font-medium text-sky-700 ring-1 ring-sky-200">${feature}</span>`)
          .join('');

        modal.classList.remove('hidden');
        modal.classList.add('flex');
      });
    });

    const heroVideo = document.getElementById('hero-video');
    const tryPlayHeroVideo = () => {
      if (!heroVideo) return;
      heroVideo.muted = true;
      heroVideo.playsInline = true;
      heroVideo.play().catch(() => {
        window.setTimeout(() => heroVideo.play().catch(() => {}), 250);
      });
    };

    if (heroVideo) {
      heroVideo.load();
      heroVideo.addEventListener('canplay', tryPlayHeroVideo, { once: true });
      heroVideo.addEventListener('loadeddata', tryPlayHeroVideo, { once: true });
      window.addEventListener('load', tryPlayHeroVideo, { once: true });
      setTimeout(tryPlayHeroVideo, 150);
    }

    modal?.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });
  </script>
</Layout>
