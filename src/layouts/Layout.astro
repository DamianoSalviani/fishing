---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	canonicalURL?: string;
	ogImage?: string;
}

const {
	title,
	description = 'Charter pesca Roma e Fiumicino. Uscite di pesca al tonno, pesce spada, drifting, traina e bolentino nel Mar Tirreno. Prenota la tua esperienza di pesca sportiva a Roma.',
	keywords = 'charter pesca roma, charter pesca fiumicino, pesca tonno roma, pesca sportiva roma, big game fishing roma, fishing charter rome, traina roma, bolentino roma, drifting tonno roma, pesce spada roma, escursioni pesca roma, uscite pesca fiumicino, pesca altura roma, charter fishing rome italy',
	canonicalURL = Astro.url.href,
	ogImage = '/og-image.jpg'
} = Astro.props;
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="UTF-8" />
		<meta name="color-scheme" content="light" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />

		<!-- SEO Meta -->
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Big Catch Fishing Charters" />
		<meta name="robots" content="index, follow" />
		<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

		<!-- Geo Tags -->
		<meta name="geo.region" content="IT-RM" />
		<meta name="geo.placename" content="Roma, Fiumicino" />
		<meta name="geo.position" content="41.7666;12.2333" />
		<meta name="ICBM" content="41.7666, 12.2333" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:locale:alternate" content="en_GB" />
		<meta property="og:site_name" content="Big Catch Fishing Charters" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Inter:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

		<title>{title}</title>

		<slot name="head" />
	</head>
	<body class="flex min-h-screen flex-col bg-white text-slate-900">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--color-primary: #0891b2;
		--color-secondary: #0ea5e9;
		--color-accent: #f97316;
		--color-background: #f0f9ff;
		--color-foreground: #0f172a;
	}
	body {
		font-family: 'Inter', system-ui, sans-serif;
	}
	h1, h2, h3, h4, h5, h6 {
		font-family: 'Montserrat', system-ui, sans-serif;
	}
	.gradient-text {
		background: linear-gradient(135deg, #0891b2, #0369a1);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	.section-badge {
		display: inline-flex;
		align-items: center;
		border-radius: 9999px;
		padding: 0.375rem 1rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
</style>
